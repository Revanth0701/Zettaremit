# TEMPLATE ONLY. Never put real secrets in this tracked file.
APP_ENV=production
DATABASE_MODE=cloud
# Set to 20261023_01 ONLY after the approved migration and schema audit succeed.
SCHEMA_REVISION=REPLACE_AFTER_APPROVED_MIGRATION
JWT_SECRET_KEY=REPLACE_WITH_NEW_RANDOM_SECRET
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
INTERNAL_SERVICE_URL=http://127.0.0.1:8082
CORS_ORIGINS=https://your-frontend.pages.dev
AIVEN_HOST=REPLACE_WITH_SERVICE_HOSTNAME
AIVEN_PORT=REPLACE_WITH_SERVICE_PORT
AIVEN_DATABASE=zettaremit
AIVEN_USER=REPLACE_WITH_RESTRICTED_APP_USER
AIVEN_PASSWORD=REPLACE_WITH_ROTATED_PASSWORD
AIVEN_CA_PATH=/etc/secrets/aiven-ca.pem
LOCAL_CREATE_TABLES=false

# Optional AI: bundled reviewed Markdown, no model training.
ENABLE_AI_ASSISTANT=false
ENABLE_AI_AGENT=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# none = BM25 only; gemini = hosted; local = optional fastembed installation.
RAG_EMBEDDING_PROVIDER=none
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_BM25_CANDIDATES=5
RAG_VECTOR_CANDIDATES=5
RAG_FINAL_CHUNKS=3
RAG_RRF_K=60
RAG_BM25_FALLBACK=true
RAG_SYNC_SECONDS=60
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=45
AGENT_TOOL_TIMEOUT_SECONDS=8
# Reuses existing daily indicative snapshot provider. none disables rate tools.
AGENT_RATE_PROVIDER=exchange_rate_api
