# Local example only. Preserve your ignored .env and .env.cloud.
APP_ENV=development
DATABASE_MODE=local
DATABASE_URL=mysql+pymysql://USER:PERCENT_ENCODED_PASSWORD@127.0.0.1:3306/instaremit_db
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_DIFFERENT_SHARED_RANDOM_SECRET
INTERNAL_SERVICE_URL=http://127.0.0.1:8082
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
LOCAL_CREATE_TABLES=false
# Do not set SCHEMA_REVISION until the corresponding migration is reviewed/applied.

# AI Assistant Configuration (Disabled by default; set true to enable)
ENABLE_AI_ASSISTANT=false
AI_PROVIDER=ollama_cloud
AI_RETRIEVER=bm25
OLLAMA_CLOUD_MODEL=gemma4:31b
# OLLAMA_API_KEY=your_ollama_cloud_api_key_here
